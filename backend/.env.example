# ─── Server ───
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naik_db?schema=public

# ─── JWT ───
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ───
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# ─── S3 Storage ───
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=naik-files
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_SIGNED_URL_EXPIRY=3600

# ─── Cloudflare R2 (large media / video) ───
# R2 exposes an S3-compatible API. Large videos are uploaded by clients
# DIRECTLY to R2 via presigned URLs — never proxied through the VPS.
# ACCOUNT_ID: the 32-char account id from the R2 dashboard URL.
R2_ACCOUNT_ID=your-r2-account-id
# API token credentials (create a token in Cloudflare Dashboard → R2 → Manage API tokens).
# NEVER expose these to the React admin or Flutter app.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Bucket name (e.g. bariisaa-media).
R2_BUCKET_NAME=your-r2-bucket
# Optional override. Defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
# Public base URL for PUBLIC (non-premium) objects, e.g. a custom domain or
# https://pub-<hash>.r2.dev. Leave empty if all content is premium/signed.
R2_PUBLIC_URL=

# ─── Firebase (Push Notifications) ───
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# ─── Email (SMTP) ───
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@naik.com
APP_URL=http://localhost:3000

# ─── SMS (AfroMessage / Africa's Talking) ───
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=sandbox
AT_FROM=NAIK

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ─── Telebirr ───
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_APP_SECRET=your-telebirr-app-secret
TELEBIRR_MERCHANT_ID=your-telebirr-merchant-id
TELEBIRR_BASE_URL=https://app.telebirr.cn

# ─── Chapa ───
CHAPA_SECRET_KEY=CHASECK_TEST_your-chapa-secret-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_BASE_URL=https://api.chapa.co/v1

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── Encryption ───
ENCRYPTION_KEY=your-32-byte-encryption-key-here
ENCRYPTION_IV_LENGTH=16

# ─── Google OAuth ───
# Comma-separated list of Google OAuth client IDs (Web, Android, iOS)
# Example: 446551709086-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com

# ─── Telegram Bot (OTP delivery / account linking) ───
# Token from @BotFather. Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# ─── Twilio SMS (optional alternative to Africa's Talking) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Seed ───
# REQUIRED when running `prisma:seed` with NODE_ENV=production.
# Dev default (naik123) is used only when NODE_ENV != production.
SEED_ADMIN_PASSWORD=
